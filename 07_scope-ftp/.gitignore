# 构建缓存（沙箱环境专用，体积大）
.cache/

# 运行期数据（dev 用 data/，其它环境用 data-*/）
data/
data-*/
logs/
*.log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Java / Maven
target/
**/target/
*.jar

# Node / 前端
node_modules/
dist/
*.local

# Rust / Tauri
**/src-tauri/target/
**/gen/schemas/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# 本机构建配置（JDK 路径等私有设置）：文件名含 local 的 env 文件一律不入库
scripts/env*local*

# 部署本地配置
deploy/.env
deploy/.env.deploy
deploy/data/
deploy/logs/

# 打包产物
release/

# 环境配置一律不入库：仓库只入库 application.yml（自带可独立启动的默认值）。
# 本地/私有环境文件（dev/docker/xiaoshan/xihu）与 CI 用 Secrets 注入的生产配置都不提交。
server/src/main/resources/application-*.yml
