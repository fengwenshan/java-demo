{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScopeFTP",
  "version": "1.0.3",
  "identifier": "com.scopftp.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScopeFTP",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "ScopeFTP",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFOEZCQzQwQ0FDOTUyODYKUldTR1VzbktRTHlQZmhXaHVvVzJLdFh5OCs1WFFhbWdxM3p5OTFHUmt0eE9iL0xsWG1hcllKVEEK",
      "endpoints": [
        "https://github.com/fengwenshan/java-demo/releases/latest/download/latest.json"
      ]
    }
  }
}
