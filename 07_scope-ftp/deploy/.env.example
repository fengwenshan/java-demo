# ScopeFTP-server Docker 部署（复制为 .env 后修改）
# 服务端 appKey / appSecret：客户端「设置」页需要填写同样的值
UPLOAD_APP_KEY=demo-app
UPLOAD_APP_SECRET=please-change-me-to-a-long-random-secret

# 容器内环境：默认激活 jar 内的 application-docker.yml
SPRING_PROFILES_ACTIVE=docker

# 宿主机端口（容器内固定 8080）
SERVER_PORT=8080

# JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m
