# ScopeFTP-server Docker 部署环境变量（复制为 .env 后修改）
# 服务端 appKey / appSecret，客户端「设置」页需要填写同样的值
UPLOAD_APP_KEY=demo-app
UPLOAD_APP_SECRET=please-change-me-to-a-long-random-secret

# 生产环境务必开启设备绑定：激活后该 appKey 只允许绑定的 deviceId 调用
UPLOAD_DEVICE_BINDING_ENABLED=true

# 单文件大小上限（字节），默认 200MB
UPLOAD_MAX_FILE_SIZE=209715200

# 宿主机端口
SERVER_PORT=8080

# JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m
